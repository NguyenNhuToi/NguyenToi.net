@model Nnt_TvcLesson12.Models.NntProduct

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h1>Chi tiết sản phẩm</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntId)</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntName)</dd>

        <!-- HIỂN THỊ ẢNH THAY VÌ TÊN FILE -->
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.NntImage))
            {
                <img src="~/Nnt_Product/@Model.NntImage" 
                     width="200" height="200" 
                     style="object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
            }
            else
            {
                <span class="text-muted">No image</span>
            }
        </dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntPrice)</dd>

        <dt class="col-sm-2">SalePrice</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntSalePrice)</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntStatus)</dd>

        <dt class="col-sm-2">Descriptions</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntDescriptions)</dd>

        <dt class="col-sm-2">CreatedDate</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntCreatedDate)</dd>

        <!-- THÊM CỘT CATEGORY -->
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NntCategoryId)</dd>
    </dl>
</div>

<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NntId">Sửa</a>
    <a class="btn btn-secondary" asp-action="Index">Về danh sách</a>
</div>
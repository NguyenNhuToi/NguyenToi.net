@model IEnumerable<Nnt_TvcLesson12.Models.NntProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h1>Danh sách sản phẩm</h1>

<p>
    <a class="btn btn-success" asp-action="Create">Thêm mới</a>
</p>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Price</th>
            <th>SalePrice</th>
            <th>Status</th>
            <th>Descriptions</th>
            <th>CreatedDate</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.NntName)</td>

            <!-- HIỂN THỊ ẢNH -->
            <td>
                @if (!string.IsNullOrEmpty(item.NntImage))
                {
                    <img src="~/Nnt_Product/@item.NntImage" 
                         width="80" height="80" 
                         style="object-fit: cover; border-radius: 5px;" />
                }
                else
                {
                    <span class="text-muted">No image</span>
                }
            </td>

            <td>@Html.DisplayFor(modelItem => item.NntPrice)</td>
            <td>@Html.DisplayFor(modelItem => item.NntSalePrice)</td>
            <td>@Html.DisplayFor(modelItem => item.NntStatus)</td>
            <td>@Html.DisplayFor(modelItem => item.NntDescriptions)</td>
            <td>@Html.DisplayFor(modelItem => item.NntCreatedDate)</td>
            <td>@Html.DisplayFor(modelItem => item.NntCategoryId)</td>

            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.NntId">Edit</a>
                <a class="btn btn-sm btn-warning" asp-action="Details" asp-route-id="@item.NntId">Details</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.NntId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>